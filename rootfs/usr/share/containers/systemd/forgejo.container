[Unit]
Description=Forgejo (self-hosted git, push-mirrors to GitHub/Codeberg)
After=network-online.target
Wants=network-online.target

[Container]
Image=codeberg.org/forgejo/forgejo:17
ContainerName=forgejo
PublishPort=3000:3000
PublishPort=2222:2222
Volume=/var/lib/forgejo:/data:Z
Environment=USER_UID=1000
Environment=USER_GID=1000
Environment=TZ=Asia/Shanghai
Environment=FORGEJO__database__DB_TYPE=sqlite3
Environment=FORGEJO__server__DOMAIN=git.router.lan
Environment=FORGEJO__server__ROOT_URL=https://git.router.lan/
Environment=FORGEJO__server__HTTP_PORT=3000
Environment=FORGEJO__server__START_SSH_SERVER=true
Environment=FORGEJO__server__SSH_PORT=2222
Environment=FORGEJO__server__SSH_LISTEN_PORT=2222
Environment=FORGEJO__service__DISABLE_REGISTRATION=true

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
