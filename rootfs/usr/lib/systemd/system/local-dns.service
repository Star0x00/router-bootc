[Unit]
Description=Local DNS zone for router.lan (dae upstream)
# Must be up before dae answers LAN queries, otherwise router.lan names briefly
# fail to resolve during boot. dae does not depend on it, so a broken zone
# cannot keep the proxy from starting.
Wants=network-pre.target
After=network-pre.target
Before=dae.service

[Service]
Type=simple
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --conf-file=/usr/share/network-services/dnsmasq/router-lan.conf
Restart=on-failure

[Install]
WantedBy=multi-user.target
