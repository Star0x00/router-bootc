[Unit]
Description=LAN DNS resolver (public upstreams, authoritative for router.lan)
# Owns 10.10.10.1:53 itself; waits for the address. dae is not involved.
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --conf-file=/usr/share/network-services/dnsmasq/router-lan.conf
Restart=on-failure

[Install]
WantedBy=multi-user.target
